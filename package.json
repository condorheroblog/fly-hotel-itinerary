		"react-router": "^8.3.1"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.5.1",
		"@eslint-react/eslint-plugin": "^5.18.7",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
